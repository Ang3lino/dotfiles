# This file replaces stow's built-in ignore list. It MUST include the
# standard defaults plus local additions. See `man stow` -- --ignore
# matches against the path.
# Standard-ish defaults (cover common VCS and backup files)
^\.git$
^\.gitignore$
^\.gitattributes$
^\.hg$
^\.bzr$
^\.svn$
^~$
^\.DS_Store$
^\.idea$
^node_modules$

# Repo-specific: prevent stowing the vendored plugin trees directly into $HOME
^znap$
^zsh-users$

# End of .stow-local-ignore
